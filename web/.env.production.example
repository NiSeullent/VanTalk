# VanTalk web — Firestore is disabled; Supabase is required.
VITE_AUTH_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/aws-proxy
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Firebase Auth (Google sign-in) — never commit the real key; set in .env.production locally / CI secrets.
VITE_FIREBASE_API_KEY=
